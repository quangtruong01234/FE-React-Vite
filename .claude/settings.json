{
  "permissions": {
    "allow": [
      "Read(**)",
      "Edit(src/**)",
      "Edit(.claude/**)",
      "Edit(tailwind.config.*)",
      "Edit(vite.config.*)",
      "Edit(tsconfig*.json)",
      "Edit(.env.example)",
      "Bash(npm run *)",
      "Bash(npx tsc *)",
      "Bash(npx shadcn *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit*)",
      "Bash(git rev-parse*)"
    ],
    "deny": [
      "Edit(src/components/ui/**)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.production)",
      "Bash(rm -rf *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(yarn *)",
      "Bash(pnpm *)",
      "Bash(bun *)",
      "Bash(git push*)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "PostToolUse": [],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npx tsc --noEmit 2>&1 | tail -20",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "[console]::beep(1000, 300); Add-Type -AssemblyName System.Windows.Forms; $n = New-Object System.Windows.Forms.NotifyIcon; $n.Icon = [System.Drawing.SystemIcons]::Information; $n.Visible = $true; $n.ShowBalloonTip(5000, 'Claude Code', 'Claude code xong rồi master', [System.Windows.Forms.ToolTipIcon]::Info); Start-Sleep 5; $n.Dispose()",
            "shell": "powershell",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}

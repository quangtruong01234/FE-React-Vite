# TryBuy Frontend — environment variables (Vite: only VITE_* reach client code)
# Copy to .env and adjust. All URLs point at the SAME NestJS gateway origin —
# there is no separate socket port. Dev CORS allows any localhost/127.0.0.1 port.

# Base path the FE fetch client prepends to every API call (proxied in dev).
VITE_API_URL=/api

# Gateway origin the Vite dev-server proxy forwards /api to (vite.config.ts).
VITE_API_TARGET=http://localhost:3000

# Socket.IO gateway origin for chat — client appends the `/chat` namespace.
VITE_CHAT_URL=http://localhost:3000

# Socket.IO gateway origin for notifications — client appends `/notifications`.
VITE_WS_NOTIFICATION_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Production (Cloudflare Workers) — do NOT put these in a committed .env file.
# They live on the repo's `production` Environment on GitHub and are injected by
# .github/workflows/deploy.yml. Full runbook: DEPLOYMENT.md
#
#   VITE_API_URL=https://api.<domain>/api
#   VITE_CHAT_URL=https://api.<domain>
#   VITE_WS_NOTIFICATION_URL=https://api.<domain>
#
# `VITE_API_URL=/api` is a DEV-ONLY value: the leading slash resolves against
# the Vite dev-server, which proxies to VITE_API_TARGET. Deployed, that same
# value resolves against the Worker's own origin, where no /api route exists, so
# `not_found_handling` answers every API call with index.html and a 200.
#
# VITE_API_TARGET is not needed in production — nothing but the dev proxy reads
# it, and the proxy does not exist in a static build.
#
# Absolute https:// URLs make the API cross-origin, which the gateway must
# allow explicitly (its own env): FRONTEND_URL=https://<worker-domain> and
# AUTH_COOKIE_SAME_SITE=none, or the auth cookie is silently dropped.
